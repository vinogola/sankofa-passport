# Copy this file to .env.local (gitignored) and fill in your own values.
#
# Vite copies every VITE_* variable into the browser bundle, so only put
# values here that are safe to be public. Never a secret/service key
# (sb_secret_...) and never the database password.
#
# Both values appear in the Connect dialog of your Supabase project (the
# Connect button at the top of the dashboard, Framework tab). The project URL
# is also under Integrations > Data API, and the keys under Settings > API Keys.
# After editing .env.local, restart `npm run dev`. On a host such as Vercel,
# set the same two variables in the project's environment settings and redeploy.

# Project URL.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (starts with sb_publishable_). Public by design: row-level
# security and the functions in supabase/migrations decide what it can do.
VITE_SUPABASE_PUBLISHABLE_KEY=
